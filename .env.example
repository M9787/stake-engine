# Copy to .env for local overrides. No secrets here.
# Pins mirror PROJECT.md section 3 (human source of truth). scripts/doctor.ps1 reads these keys.
NODE_VERSION=22.16.0
PNPM_VERSION=10.5.0
PYTHON_MIN_VERSION=3.12
RUST_VERSION=1.98.1

# Local paths (relative to repo root)
MATH_SDK_DIR=math-sdk
WEB_SDK_DIR=web-sdk

# Target game
WEB_APP=seventh-veil
MATH_GAME=seventh_veil
