{
  "_comment": "Core asset-slot catalogue (docs/10 plan v3.3 section 3). Core data: no skin words, prompts use {tokens} only. Skins fill slots in skins/<id>/assets.json. 'expand' makes one slot per symbol or bonus variant from game.json. required: ship = package refuses a fallback; optional = may stay on fallback; source = style source, not shipped.",
  "schemaVersion": 1,
  "sittings": [
    { "id": 1, "title": "Hero and symbols", "minutes": 60, "note": "Make the hero first, pick 1 of 4, upscale, then paste its image URL into the style reference field. Every later image uses it." },
    { "id": 2, "title": "Backgrounds, frame, panels, UI", "minutes": 60, "note": "Uses the style reference from sitting 1." },
    { "id": 3, "title": "Logo, tiles, cover, fonts, re-dos", "minutes": 60, "note": "No words in any image: the game adds all text itself." },
    { "id": 4, "title": "Music", "minutes": 45, "note": "Instrumental on. Long files are fine: the pipeline cuts loops and trims stings." },
    { "id": 5, "title": "Sound effects", "minutes": 45, "note": "CC0 libraries first. Copy each sound's page URL into the provenance line." }
  ],
  "editRecipes": {
    "symbol": ["Fix any malformed detail (hands, glyphs, edges) with the brush or clone tool", "Shift the main colours onto the palette by hand (Hue/Saturation per colour)", "Strengthen the silhouette: darken the outline, remove stray background specks"],
    "background": ["Clear the centre area where the board sits", "Repaint or remove any artefact, text-like mark or repeated pattern", "Balance light so the edges stay readable on a phone"],
    "frame": ["Make the inner area fully transparent and straight", "Repair asymmetric ornaments by mirroring one half", "Recolour metal toward the palette accent"],
    "panel": ["Clear the text area to a calm flat zone", "Repair edges and corners", "Recolour toward the palette"],
    "ui": ["Centre the icon and square the canvas", "Simplify noisy detail so it reads at 64 px", "Recolour metal toward the palette accent"],
    "logo": ["Repair symmetry", "Remove any letter-like marks", "Leave clear space for the game title the build adds"],
    "tile": ["Brighten the edges (Engine tile rule)", "Remove any letter-like marks", "Recompose so the subject sits in the safe zone"]
  },
  "audioLicences": ["suno-pro", "suno-premier", "cc0", "owner-made"],
  "imageLicences": ["midjourney-pro", "midjourney-mega", "owner-made"],
  "fontLicences": ["ofl"],
  "testLicence": "test",
